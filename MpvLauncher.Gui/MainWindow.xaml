                                        <TextBlock x:Name="TxtColorTextSecondaryLabel" Text="Secondary Text:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtColorTextSecondary" Background="{DynamicResource InputBrush}" Foreground="White" FontSize="12" Padding="8,4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                                            <Button Grid.Column="1" Click="BtnPickColor_Click" Tag="TxtColorTextSecondary" Style="{StaticResource SecondaryButton}" Padding="0" Margin="4,0,0,0" ToolTip="{DynamicResource PickColorTip}">
                                                <Viewbox Width="14" Height="14">
                                                    <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M20.7,3.3a2.4,2.4 0 0 0-3.4,0l-2.6,2.6-1.2-1.2-1.4,1.4 1.2,1.2L5,15.6V19h3.4l8.3-8.3 1.2,1.2 1.4-1.4-1.2-1.2 2.6-2.6a2.4,2.4 0 0 0 0-3.4Z"/>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <!-- Logo Color -->
                                    <StackPanel Grid.Column="3" Margin="6,0,0,0">
                                        <TextBlock x:Name="TxtColorLogoLabel" Text="Logo Color:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtColorLogo" Background="{DynamicResource InputBrush}" Foreground="White" FontSize="12" Padding="8,4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                                            <Button Grid.Column="1" Click="BtnPickColor_Click" Tag="TxtColorLogo" Style="{StaticResource SecondaryButton}" Padding="0" Margin="4,0,0,0" ToolTip="{DynamicResource PickColorTip}">
                                                <Viewbox Width="14" Height="14">
                                                    <Path Fill="{DynamicResource TextPrimaryBrush}" Data="M20.7,3.3a2.4,2.4 0 0 0-3.4,0l-2.6,2.6-1.2-1.2-1.4,1.4 1.2,1.2L5,15.6V19h3.4l8.3-8.3 1.2,1.2 1.4-1.4-1.2-1.2 2.6-2.6a2.4,2.4 0 0 0 0-3.4Z"/>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="BtnApplyColors" Style="{StaticResource ModernButton}" Content="Apply Colors" Click="BtnApplyColors_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnSaveTheme" Style="{StaticResource SecondaryButton}" Content="Save as theme" Click="BtnSaveTheme_Click"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtCustomBgTitle" Text="Custom Background Image" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomBgUrl" Background="{DynamicResource InputBrush}" Foreground="White" FontSize="12" Padding="10,4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnBrowseBgImage" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse" Click="BtnBrowseBgImage_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnApplyCustomBg" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Apply" Click="BtnApplyCustomBg_Click"/>
                                </Grid>

                                <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                    <Button x:Name="BtnResetThemeDefaults" Style="{StaticResource ModernButton}" Background="{DynamicResource DangerBrush}" Content="Varsayılana Döndür" Click="BtnResetThemeDefaults_Click" HorizontalAlignment="Left" Padding="18,10"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelGuide" Visibility="Collapsed">
                        <TextBlock x:Name="TxtGuideTitle" Text="User Guide &amp; Information" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtGuideQuickStartTitle" Text="🎬 Hızlı Başlangıç &amp; Video Oynatma" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtGuideQuickStartSub" Text="MPV Launcher, internet akışlarını ve yerel medya dosyalarını yüksek performanslı MPV oynatıcı ile sorunsuz izlemenizi sağlar." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtGuideQuickStartBody" Text="• URL Oynatma: YouTube, Twitch, Vimeo, Twitter/X ve yüzlerce desteklenen siteden video bağlantısını 'Player' sekmesindeki kutuya yapıştırıp 'MPV ile Oynat' butonuna basın veya Enter'a tıklayın.&#x0a;• Sürükle &amp; Bırak: Bilgisayarınızdaki video dosyalarını (.mp4, .mkv, .webm vb.) doğrudan pencerenin içerisine sürükleyip bırakabilirsiniz.&#x0a;• Oynatma Geçmişi: Daha önce oynattığınız son 50 medya kaydı geçmiş listesinde saklanır; listedeki bir öğeye çift tıklayarak tekrar izleyebilirsiniz." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtGuideDepsTitle" Text="📦 Bağımlılıklar (MPV, yt-dlp, FFmpeg)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtGuideDepsSub" Text="Programın tam performansla çalışması için üç temel araç gereklidir:" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtGuideDepsBody" Text="1. MPV: Modern ve donanım hızlandırmalı video oynatıcı motorudur.&#x0a;2. yt-dlp: YouTube ve diğer sitelerden canlı akış ve video verilerini çeken yardımcı programdır. Sitelerin güncellemeleri nedeniyle yt-dlp sık sık güncellenir; akış açılmadığında 'Program güncellemelerini denetle' düğmesini kullanabilirsiniz.&#x0a;3. FFmpeg: Medya akışlarını ayrıştırma ve birleştirme motorudur.&#x0a;&#x0a;Tüm bu araçları 'Bağımlılıklar' sekmesinden tek tıkla otomatik indirebilir ve kurabilirsiniz." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtGuideBrowserTitle" Text="🌐 Tarayıcı Entegrasyonu (Browser Extensions)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtGuideBrowserSub" Text="Tarayıcınızda gezinirken videoları tek tıkla doğrudan MPV'de açabilirsiniz:" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtGuideBrowserBody" Text="• Chrome / Edge / Brave / Opera: 'chrome://extensions' sayfasında sağ üstteki 'Geliştirici Modu'nu açın. 'Paketlenmemiş öge yükle' butonuna basarak 'Eklenti Klasörünü Aç' ile açılan klasörü seçin.&#x0a;• Firefox: 'Firefox Eklentisi' butonuna tıklayarak Mozilla resmi eklenti mağazasından tek tıkla kurabilirsiniz.&#x0a;• Native Messaging Host: Uygulama ilk çalıştığında kayıt defteri ve protokol bağlantılarını otomatik olarak hazırlar." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtGuideAnime4kTitle" Text="✨ Anime4K &amp; ModernZ Teması" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtGuideAnime4kSub" Text="Anime4K, anime ve çizim içeriklerini gerçek zamanlı olarak 1080p / 4K çözünürlüğe yükselten ve kenarları netleştiren yapay zeka algoritmasıdır." FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtGuideAnime4kBody" Text="• 'Tema' sekmesindeki 'Tema+Anime4K Kur' butonu ile ModernZ arayüzünü ve Anime4K GLSL shader dosyalarını %APPDATA%\mpv dizinine yükleyebilirsiniz.&#x0a;• MPV Klavye Kısayolları:&#x0a;   - CTRL+0: Anime4K'yı Devre Dışı Bırak&#x0a;   - CTRL+1: Anime4K Mode A (Hızlı / Fast)&#x0a;   - CTRL+2: Anime4K Mode B (Yüksek Kalite / HQ)&#x0a;   - CTRL+3: Anime4K Mode C (Çok Hızlı / Very Fast)&#x0a;   - CTRL+4: Anime4K Mode A+A (Gelişmiş)&#x0a;   - CTRL+5: Anime4K Mode B+B (Maksimum Keskinlik)&#x0a;   - CTRL+6: Anime4K Mode C+A" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="TxtGuideCustomTitle" Text="🎨 Arayüz &amp; Tema Kişiselleştirme İpuçları" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtGuideCustomSub" Text="Uygulamanın tüm görsel detaylarını 'Tema' sekmesinden dilediğiniz gibi özelleştirebilirsiniz:" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtGuideCustomBody" Text="• Pencere ve Kart Köşeleri: Köşe yuvarlaklıklarını 0px (keskin köşeler) ile 24px (tam yuvarlak) arasında ayarlayın.&#x0a;• Bağımsız Şeffaflık: Kartlar, sol sidebar, yazı kutuları ve butonlar için ayrı ayrı şeffaflık seviyesi belirleyin.&#x0a;• Buzlu Cam &amp; Gölge: Arka plan bulanıklığını ve pencere gölgesinin belirginliğini kaydırıcılarla anlık olarak önizleyin.&#x0a;• Varsayılana Dönüş: Yaptığınız değişiklikleri istediğiniz an sayfa altındaki kırmızı 'Varsayılana Döndür' butonuna basarak orijinal ayarlara döndürebilirsiniz." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelReport" Visibility="Collapsed">
                        <TextBlock x:Name="TxtReportTitle" Text="Report" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="TxtReportKindLabel" Text="Type" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <ListBox x:Name="LstReportKind" Height="118" Margin="0,0,0,18" Background="Transparent" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"/>

                                <TextBlock x:Name="TxtReportMessageLabel" Text="Message" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <TextBox x:Name="TxtReportMessage" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10,8" Margin="0,0,0,16" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CaretBrush="{DynamicResource TextPrimaryBrush}"/>

                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="BtnReportAddFile" Style="{StaticResource ModernButton}" Background="{DynamicResource AccentBrush}" Foreground="White" Padding="12,7" DockPanel.Dock="Left" Click="BtnReportAddFile_Click" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 6,0 L 6,12 M 0,6 L 12,6" Stroke="White" StrokeThickness="1.6" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtReportAddFileLabel" Text="Add file" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="TxtReportFilesHint" Text="Images or logs, up to 8 MB each." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </DockPanel>

                                <ItemsControl x:Name="LstReportFiles" Margin="0,0,0,4">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7,26,7" Margin="0,0,8,8">
                                                <Grid>
                                                    <StackPanel Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <Button Tag="{Binding}" Click="BtnReportRemoveFile_Click" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="{DynamicResource ReportRemoveTip}">
                                                        <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button x:Name="BtnReportSend" Style="{StaticResource ModernButton}" Background="{DynamicResource AccentBrush}" Foreground="White" Padding="18,10" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BtnReportSend_Click" Cursor="Hand">
                                    <TextBlock x:Name="TxtReportSendLabel" Text="Send report"/>
                                </Button>

                                <TextBlock x:Name="TxtReportStatus" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                                <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtReportWebhookNote" Text="Reports are delivered to the developer's Discord webhook." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtReportTrNote" Text="Discord is blocked in Turkey. Turn on a VPN before sending." FontSize="11" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Border>
</Window>

<Window x:Class="MpvLauncher.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MPV Launcher" Height="680" Width="1040"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#F0F2F5"
        FontFamily="Segoe UI, Inter, Arial"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA3B2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBdr" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBdr" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#252A38"/>
            <Setter Property="Foreground" Value="#F0F2F5"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9AA3B2"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#12141A" CornerRadius="16" BorderBrush="#2E384D" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Image x:Name="BgImageElement" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border x:Name="BgOverlayBorder" Background="#B20D0F18" CornerRadius="16">
                <Border.Effect>
                    <BlurEffect x:Name="BgBlurEffect" Radius="8"/>
                </Border.Effect>
            </Border>

            <Grid VerticalAlignment="Top" Height="38" Background="Transparent" MouseDown="TitleBar_MouseDown" Panel.ZIndex="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtTitleBar" Text="MPV Launcher" FontSize="12" FontWeight="Bold" Foreground="#9AA3B2"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="BtnMinimize" Style="{StaticResource WindowControlButton}" Content="🗕" Click="BtnMinimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}" Content="✕" Click="BtnClose_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,38,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SidebarBorder" Grid.Column="0" Background="#A612141A" BorderBrush="#1FFFFFFF" BorderThickness="0,0,1,0" Padding="16,14">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                        <Border x:Name="BorderBrandIcon" Width="34" Height="34" Background="#6366F1" CornerRadius="8" Margin="0,0,10,0">
                            <TextBlock Text="▶" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtSidebarBrand" Text="MPV Launcher" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="BtnNavPlayer" Style="{StaticResource NavButton}" Content="Player" Click="BtnNavPlayer_Click" Background="#6366F1" Foreground="White" Margin="0,0,0,4"/>
                        <Button x:Name="BtnNavTools" Style="{StaticResource NavButton}" Content="Dependencies" Click="BtnNavTools_Click" Margin="0,0,0,4"/>
                        <Button x:Name="BtnNavSettings" Style="{StaticResource NavButton}" Content="Themes &amp; Settings" Click="BtnNavSettings_Click" Margin="0,0,0,4"/>
                    </StackPanel>

                    <Border x:Name="StatusLogBorder" Grid.Row="2" Background="#22000000" CornerRadius="8" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="10,8" Margin="0,10,0,0" MinHeight="64" MaxHeight="100">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Top" Margin="0,4,8,0"/>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="#9AA3B2" TextWrapping="Wrap" LineHeight="15"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,24">
                <Grid>
                    <StackPanel x:Name="PanelPlayer" Visibility="Visible">
                        <TextBlock x:Name="TxtPlayerTitle" Text="Media &amp; Stream Player" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtPlayerDesc" Text="Paste a video URL or drag and drop a local video file." FontSize="13" Foreground="#9AA3B2" Margin="0,0,0,20"/>

                        <Border x:Name="CardUrl" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtUrlInput" Background="#33000000" Foreground="White" FontSize="13" Padding="12,10" BorderBrush="#33FFFFFF" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,10,0" KeyDown="TxtUrlInput_KeyDown"/>
                                    <Button x:Name="BtnPlayUrl" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Play with MPV" Click="BtnPlayUrl_Click"/>
                                </Grid>

                                <Border x:Name="DropZoneBorder" Background="#15FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="2" CornerRadius="8" Padding="24" Margin="0,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📁" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtDropZone" Text="Drag and drop a video file here" FontSize="13" Foreground="#9AA3B2" HorizontalAlignment="Center"/>
                                        <Button x:Name="BtnBrowseFile" Style="{StaticResource SecondaryButton}" Content="Select File" Click="BtnBrowseFile_Click" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="12,6" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardHistory" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtHistoryTitle" Text="Playback history" FontSize="15" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnClearHistory" Content="Clear history" Click="BtnClearHistory_Click" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12"/>
                                </Grid>
                                <ListBox x:Name="LstHistory" Background="Transparent" BorderThickness="0" Foreground="#F0F2F5" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="LstHistory_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#22000000" CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Url}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelTools" Visibility="Collapsed">
                        <TextBlock x:Name="TxtToolsTitle" Text="Dependencies &amp; Browser" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Border x:Name="CardStatus" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtSystemStatus" Text="System status" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#22000000" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="MPV" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtMpvStatus" Text="Checking..." FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#22000000" CornerRadius="8" Padding="12" Margin="6,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="YT-DLP" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtYtdlStatus" Text="Checking..." FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#22000000" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="FFMPEG" FontSize="11" Foreground="#64748B" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtFfmpegStatus" Text="Checking..." FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnUpdateYtdl" Style="{StaticResource ModernButton}" Content="Update yt-dlp (-U)" Click="BtnUpdateYtdl_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnRefreshTools" Style="{StaticResource SecondaryButton}" Content="Refresh" Click="BtnRefreshTools_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardDownloads" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtDownloadsTitle" Text="Download sources" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtInstallDir" Text="" FontSize="12" Foreground="#9AA3B2" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <Border Background="#22000000" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="MPV (x86_64-v3)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="shinchiro/mpv-winbuild-cmake → mpv-x86_64-v3*.7z" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnInstallMpv" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Download &amp; Install" Click="BtnInstallMpv_Click" VerticalAlignment="Center" Padding="14,8"/>
                                    </Grid>
                                </Border>

                                <Border Background="#22000000" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="yt-dlp" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="yt-dlp/yt-dlp → yt-dlp_win.zip" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnInstallYtdlp" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Download &amp; Install" Click="BtnInstallYtdlp_Click" VerticalAlignment="Center" Padding="14,8"/>
                                    </Grid>
                                </Border>

                                <Border Background="#22000000" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="FFmpeg (essentials)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="gyan.dev → ffmpeg-git-essentials.7z" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnInstallFfmpeg" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Download &amp; Install" Click="BtnInstallFfmpeg_Click" VerticalAlignment="Center" Padding="14,8"/>
                                    </Grid>
                                </Border>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtDownloadStage" Text="Ready" FontSize="12" Foreground="#9AA3B2"/>
                                    <TextBlock x:Name="TxtDownloadPct" Text="" FontSize="12" Foreground="#9AA3B2" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar x:Name="BarDownload" Height="8" Minimum="0" Maximum="100" Value="0" Background="#22000000" Foreground="#6366F1" BorderThickness="0"/>
                                <TextBlock x:Name="TxtDownloadDetail" Text="" FontSize="11" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardBrowser" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="TxtBrowserTitle" Text="Browser extension integration" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtBrowserDesc" Text="Eklenti native messaging altyapısını kurar. Firefox için resmi mağazadan yükleyebilirsiniz. Chromium tarayıcılarda 'Geliştirici Modu'nu açıp paketlenmemiş klasörü yükleyin." FontSize="13" Foreground="#9AA3B2" Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="BtnInstallExtensions" Style="{StaticResource ModernButton}" Content="Install / repair" Click="BtnInstallExtensions_Click" Margin="0,0,10,10"/>
                                    <Button x:Name="BtnFirefoxAddon" Style="{StaticResource ModernButton}" Content="🦊 Firefox Eklentisi" Click="BtnFirefoxAddon_Click" Margin="0,0,10,10" Background="#E55B00" BorderBrush="#FF6A00"/>
                                    <Button x:Name="BtnOpenExtensionFolder" Style="{StaticResource SecondaryButton}" Content="Extension Folder" Click="BtnOpenExtensionFolder_Click" Margin="0,0,10,10"/>
                                    <Button x:Name="BtnOpenChromeExtensions" Style="{StaticResource SecondaryButton}" Content="chrome://extensions" Click="BtnOpenChromeExtensions_Click" Margin="0,0,10,10"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtExtensionStatus" Text="" FontSize="12" Foreground="#9AA3B2" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                        <TextBlock x:Name="TxtSettingsTitle" Text="Appearance &amp; Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Border x:Name="CardDataFolder" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtDataFolderTitle" Text="Application data folder" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtDataFolderPath" Text="" FontSize="12" Foreground="#9AA3B2" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <Button x:Name="BtnShowDataFolder" Style="{StaticResource SecondaryButton}" Content="Show folder" Click="BtnShowDataFolder_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardThemeAnime4k" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtThemeAnime4kTitle" Text="ModernZ Tema + Anime4K" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtThemeAnime4kDesc" Text="ModernZ temasını indirir ve Anime4K GLSL shader/ayarlarını %APPDATA%\mpv içerisine yükler." FontSize="12" Foreground="#9AA3B2" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnInstallThemeAnime4k" Style="{StaticResource ModernButton}" Content="Tema+anime4k" Click="BtnInstallThemeAnime4k_Click" Padding="16,8"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtThemeAnime4kStatus" Text="" FontSize="12" Foreground="#6366F1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardThemes" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtThemesTitle" Text="Available themes" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <WrapPanel x:Name="PanelThemesWrap" Margin="0,0,0,16"/>

                                <Border BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtThemeImport" Text="Import theme from URL (GitHub / Pastebin RAW JSON)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtThemeUrl" Background="#33000000" Foreground="White" FontSize="12" Padding="10,8" BorderBrush="#33FFFFFF" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                            <Button x:Name="BtnImportTheme" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Download &amp; Apply" Click="BtnImportTheme_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardCustomBg" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtCustomBgTitle" Text="Custom background &amp; glass effect" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomBgUrl" Background="#33000000" Foreground="White" FontSize="12" Padding="10,8" BorderBrush="#33FFFFFF" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnApplyCustomBg" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Apply" Click="BtnApplyCustomBg_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtOpacityLabel" Text="Card opacity:" FontSize="12" Foreground="#9AA3B2"/>
                                            <TextBlock x:Name="TxtOpacityVal" Text="85%" FontSize="12" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderOpacity" Minimum="20" Maximum="100" Value="85" ValueChanged="SliderOpacity_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock x:Name="TxtBlurLabel" Text="Frosted glass (blur):" FontSize="12" Foreground="#9AA3B2"/>
                                            <TextBlock x:Name="TxtBlurVal" Text="8px" FontSize="12" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Slider x:Name="SliderBlur" Minimum="0" Maximum="30" Value="8" ValueChanged="SliderBlur_ValueChanged"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardLang" Background="#CC1E222D" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="TxtLangTitle" Text="Language" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <ComboBox x:Name="CmbLanguage" Height="34" Margin="0,0,0,14" SelectionChanged="CmbLanguage_SelectionChanged"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtLangUrl" Background="#33000000" Foreground="White" FontSize="12" Padding="10,8" BorderBrush="#33FFFFFF" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnImportLang" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Download language" Click="BtnImportLang_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
    </Border>
</Window>

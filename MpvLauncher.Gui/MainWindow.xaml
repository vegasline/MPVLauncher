<Window x:Class="MpvLauncher.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:svc="clr-namespace:MpvLauncher.Gui.Services"
        mc:Ignorable="d"
        Title="MPV Launcher" Height="680" Width="1040"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Activated="Window_Activated"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Inter, Arial"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Defaults only: UpdateTheme replaces every one of these with the
             active theme's colour at startup, and DynamicResource references
             below pick the new brush up without touching the tree. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B2"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#22000000"/>
        <SolidColorBrush x:Key="InputBrush" Color="#33000000"/>
        <SolidColorBrush x:Key="CardBrush" Color="#CC1E222D"/>
        <SolidColorBrush x:Key="WindowBrush" Color="#12141A"/>
        <SolidColorBrush x:Key="PopupBrush" Color="#1E222D"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#252A38"/>
        <SolidColorBrush x:Key="DangerButtonBrush" Color="#3A1D22"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#363B4D"/>
        <SolidColorBrush x:Key="WindowBorderBrush" Color="#2E384D"/>
        <sys:Double x:Key="ButtonOpacity">1</sys:Double>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBdr" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBdr" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBdr" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="{DynamicResource ButtonOpacity}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource HairlineBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PopupBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#15FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ToggleBorder" Property="Background" Value="#206366F1"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8,12,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ToggleButton x:Name="ToggleButton"
                                              Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="False"
                                              ClickMode="Press"
                                              Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="ContentSite"
                                                          Grid.Column="0"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"
                                                          TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Path Grid.Column="1"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource TextSecondaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource PopupBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#806366F1"/>
                                <Setter TargetName="ComboBorder" Property="Background" Value="#44000000"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ComboBorder" Property="Background" Value="#55000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBarButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Background" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#C06366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Root" Width="10" Background="Transparent">
                            <Border x:Name="TrackBg" Background="{TemplateBinding Background}" CornerRadius="5" Opacity="0.55"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ModernScrollBarButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ModernScrollBarButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root" Property="Width" Value="Auto"/>
                                <Setter TargetName="Root" Property="Height" Value="10"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="CanContentScroll" Value="True"/>
            <Setter Property="PanningMode" Value="VerticalFirst"/>
            <Setter Property="svc:ScrollAutoHide.Enabled" Value="True"/>
        </Style>

        <!-- The controls below were left with their system chrome, which is a
             light-grey box with a blue focus ring: on a dark theme they are the
             most obvious thing on the screen. Each template here is the minimum
             needed to use the palette and keep keyboard focus visible. -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 0 4 L 3 7 L 9 0"
                                      Stroke="{DynamicResource OnAccentBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{DynamicResource HairlineBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Ellipse Fill="{DynamicResource AccentBrush}"
                                                         Stroke="{DynamicResource OnAccentBrush}"
                                                         StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" Height="4"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource PopupBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource WindowBrush}" CornerRadius="8" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid x:Name="WindowContentClip" SizeChanged="WindowContentClip_SizeChanged">
            <Image x:Name="BgImageElement" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Border x:Name="BgOverlayBorder" Background="#B20D0F18" CornerRadius="8">
                <Border.Effect>
                    <BlurEffect x:Name="BgBlurEffect" Radius="8"/>
                </Border.Effect>
            </Border>

            <Grid VerticalAlignment="Top" Height="38" Background="Transparent" MouseDown="TitleBar_MouseDown" Panel.ZIndex="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtTitleBar" Text="MPV Launcher" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <!-- Icons are drawn, not glyphs: a font that lacks the
                         codepoint turned these into boxes on some systems. -->
                    <Button x:Name="BtnMinimize" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click" ToolTip="Minimize">
                        <Path Data="M 0,0 H 10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource WindowCloseButton}" Click="BtnClose_Click" ToolTip="Close">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Margin="0,38,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SidebarBorder" Grid.Column="0" Background="#A612141A" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0" Padding="16,14">
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                        <Border x:Name="BorderBrandIcon" Width="34" Height="34" Background="{DynamicResource AccentBrush}" CornerRadius="8" Margin="0,0,10,0">
                            <Path Data="M 0,0 L 12,6.5 L 0,13 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </Border>
                        <TextBlock x:Name="TxtSidebarBrand" Text="MPV Launcher" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="BtnNavPlayer" Style="{StaticResource NavButton}" Content="Player" Click="BtnNavPlayer_Click" Background="{DynamicResource AccentBrush}" Foreground="White" Margin="0,0,0,4"/>
                        <Button x:Name="BtnNavTools" Style="{StaticResource NavButton}" Content="Dependencies" Click="BtnNavTools_Click" Margin="0,0,0,4"/>
                        <Button x:Name="BtnNavSettings" Style="{StaticResource NavButton}" Content="Settings" Click="BtnNavSettings_Click" Margin="0,0,0,4"/>
                        <Button x:Name="BtnNavThemes" Style="{StaticResource NavButton}" Content="Themes" Click="BtnNavThemes_Click" Margin="0,0,0,4"/>
                        <Button x:Name="BtnNavGuide" Style="{StaticResource NavButton}" Content="Guide" Click="BtnNavGuide_Click" Margin="0,0,0,4"/>
                        <Button x:Name="BtnNavReport" Style="{StaticResource NavButton}" Content="Report" Click="BtnNavReport_Click" Margin="0,0,0,4"/>
                    </StackPanel>

                    <Border x:Name="StatusLogBorder" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="10,8" Margin="0,10,0,0" MinHeight="64" MaxHeight="100">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Top" Margin="0,4,8,0"/>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="15"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="30,24">
                <Grid>
                    <StackPanel x:Name="PanelPlayer" Visibility="Visible">
                        <TextBlock x:Name="TxtPlayerTitle" Text="Media &amp; Stream Player" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtPlayerDesc" Text="Paste a video URL or drag and drop a local video file." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                        <Border x:Name="CardUrl" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,10,0">
                                        <TextBox x:Name="TxtUrlInput" Background="{DynamicResource InputBrush}" Foreground="White" FontSize="13" Padding="12,5" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalContentAlignment="Center" KeyDown="TxtUrlInput_KeyDown"/>
                                        <TextBlock x:Name="TxtUrlHint" Text="Paste a URL or magnet link" FontSize="13" Foreground="#8892A4" Margin="14,0,14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtUrlInput}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button x:Name="BtnPlayUrl" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Play with MPV" Click="BtnPlayUrl_Click"/>
                                </Grid>

                                <Border x:Name="DropZoneBorder" Background="#15FFFFFF" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="2" CornerRadius="8" Padding="24" Margin="0,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Grid Width="34" Height="34" HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Opacity="0.92"/>
                                            <Path Fill="White" Data="M 0,0 L 12,6.5 L 0,13 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="TxtDropZone" Text="Drag and drop a video file here" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        <Button x:Name="BtnBrowseFile" Style="{StaticResource SecondaryButton}" Content="Select File" Click="BtnBrowseFile_Click" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="12,6" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardTorrent" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtTorrentTitle" Text="Torrent streaming" FontSize="15" FontWeight="SemiBold"/>
                                    <Button x:Name="BtnTorrentCancel" Style="{StaticResource SecondaryButton}" Content="Cancel" Click="BtnTorrentCancel_Click" HorizontalAlignment="Right" Padding="12,6" FontSize="12"/>
                                </Grid>
                                <TextBlock x:Name="TxtTorrentStatus" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="BarTorrent" Height="6" Margin="0,10,0,6" Minimum="0" Maximum="1" Value="0" Foreground="#3B82F6" Background="{DynamicResource InputBrush}" BorderThickness="0" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtTorrentDetail" Text="" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                <Button x:Name="BtnTorrentOpenSettings" Style="{StaticResource SecondaryButton}" Content="Open torrent settings" Click="BtnTorrentOpenSettings_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6" FontSize="12" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardHistory" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtHistoryTitle" Text="Playback history" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="TxtHistorySearch" Width="190" FontSize="12" Padding="8,5" Margin="0,0,8,0"
                                                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                 VerticalContentAlignment="Center" TextChanged="TxtHistorySearch_TextChanged"
                                                 ToolTipService.ShowOnDisabled="True"/>
                                        <Button x:Name="BtnClearHistory" Content="Clear history" Click="BtnClearHistory_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="LstHistory" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="LstHistory_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DataTemplate.Resources>
                                                <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                                                <Style x:Key="RowButton" TargetType="Button">
                                                    <Setter Property="Width" Value="26"/>
                                                    <Setter Property="Height" Value="26"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HairlineBrush}"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </DataTemplate.Resources>
                                            <Border CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="BorderThickness" Value="0,0,3,0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                                                        <TextBlock Text="{Binding Url}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource RowButton}" Tag="{Binding}" Click="BtnHistoryPin_Click" ToolTip="{DynamicResource HistoryPinTip}">
                                                        <Viewbox Width="13" Height="13">
                                                            <Path Data="M 8,1 L 10.1,6 L 15.3,6.4 L 11.3,9.8 L 12.5,15 L 8,12.2 L 3.5,15 L 4.7,9.8 L 0.7,6.4 L 5.9,6 Z"
                                                                  Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Viewbox>
                                                    </Button>
                                                    <Button Grid.Column="2" Style="{StaticResource RowButton}" Tag="{Binding}" Click="BtnHistoryFolder_Click"
                                                            Visibility="{Binding IsLocalFile, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource HistoryFolderTip}">
                                                        <Viewbox Width="14" Height="14">
                                                            <Path Data="M 1,3 L 6,3 L 7.6,5 L 15,5 L 15,13 L 1,13 Z" Fill="Transparent" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.3"/>
                                                        </Viewbox>
                                                    </Button>
                                                    <Button Grid.Column="3" Style="{StaticResource RowButton}" Tag="{Binding}" Click="BtnHistoryDelete_Click" ToolTip="{DynamicResource HistoryDeleteTip}">
                                                        <Viewbox Width="11" Height="11">
                                                            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelTools" Visibility="Collapsed">
                        <TextBlock x:Name="TxtToolsTitle" Text="Dependencies &amp; Browser" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Border x:Name="CardStatus" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtSystemStatus" Text="System status" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="MPV" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtMpvStatus" Text="Checking..." FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="6,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="YT-DLP" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtYtdlStatus" Text="Checking..." FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="FFMPEG" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtFfmpegStatus" Text="Checking..." FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnCheckToolUpdates" Style="{StaticResource ModernButton}" Content="Check program updates" Click="BtnCheckToolUpdates_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnRefreshTools" Style="{StaticResource SecondaryButton}" Content="Refresh" Click="BtnRefreshTools_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardDownloads" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtDownloadsTitle" Text="Download sources" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtInstallDir" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="MPV (x86_64-v3)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="shinchiro/mpv-winbuild-cmake → mpv-x86_64-v3*.7z" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnInstallMpv" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Download &amp; Install" Click="BtnInstallMpv_Click" VerticalAlignment="Center" Padding="14,8"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="yt-dlp" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="yt-dlp/yt-dlp → yt-dlp_win.zip" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnInstallYtdlp" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Download &amp; Install" Click="BtnInstallYtdlp_Click" VerticalAlignment="Center" Padding="14,8"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="FFmpeg (essentials)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="gyan.dev → ffmpeg-git-essentials.7z" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnInstallFfmpeg" Grid.Column="1" Style="{StaticResource ModernButton}" Content="Download &amp; Install" Click="BtnInstallFfmpeg_Click" VerticalAlignment="Center" Padding="14,8"/>
                                    </Grid>
                                </Border>

                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtDownloadStage" Text="Ready" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="TxtDownloadPct" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar x:Name="BarDownload" Height="8" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                                <TextBlock x:Name="TxtDownloadDetail" Text="" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>


                        <Border x:Name="CardThemeAnime4k" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtThemeAnime4kTitle" Text="ModernZ Tema + Anime4K" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtThemeAnime4kDesc" Text="ModernZ temasını indirir ve Anime4K GLSL shader/ayarlarını %APPDATA%\mpv içerisine yükler." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnInstallThemeAnime4k" Style="{StaticResource ModernButton}" Content="Tema+anime4k" Click="BtnInstallThemeAnime4k_Click" Padding="16,8"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtThemeAnime4kStatus" Text="" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardBrowser" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="TxtBrowserTitle" Text="Browser extension integration" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtBrowserDesc" Text="Eklenti native messaging altyapısını kurar. Firefox için resmi mağazadan yükleyebilirsiniz. Chromium tarayıcılarda 'Geliştirici Modu'nu açıp paketlenmemiş klasörü yükleyin." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="BtnInstallExtensions" Style="{StaticResource ModernButton}" Content="Install / repair" Click="BtnInstallExtensions_Click" Margin="0,0,10,10"/>
                                    <Button x:Name="BtnUninstallExtensions" Style="{StaticResource DangerButton}" Content="Uninstall extension" Click="BtnUninstallExtensions_Click" Margin="0,0,10,10"/>
                                    <Button x:Name="BtnFirefoxAddon" Style="{StaticResource ModernButton}" Content="🦊 Firefox Eklentisi" Click="BtnFirefoxAddon_Click" Margin="0,0,10,10" Background="#E55B00" BorderBrush="#FF6A00"/>
                                    <Button x:Name="BtnOpenExtensionFolder" Style="{StaticResource SecondaryButton}" Content="Extension Folder" Click="BtnOpenExtensionFolder_Click" Margin="0,0,10,10"/>
                                    <Button x:Name="BtnOpenChromeExtensions" Style="{StaticResource SecondaryButton}" Content="chrome://extensions" Click="BtnOpenChromeExtensions_Click" Margin="0,0,10,10"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtExtensionStatus" Text="" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                        <TextBlock x:Name="TxtSettingsTitle" Text="Settings" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Border x:Name="CardMpvConfig" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtMpvConfigTitle" Text="MPV Player Configuration" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14"/>

                                <TextBlock x:Name="TxtMpvPathLabel" Text="MPV Executable Path:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtMpvPath" Background="{DynamicResource InputBrush}" Foreground="White" FontSize="12" Padding="10,4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnBrowseMpv" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Browse" Click="BtnBrowseMpv_Click"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkAlwaysOnTop" Grid.Column="0" Content="Always on top (--ontop)" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock x:Name="TxtForceWindowLabel" Text="Force Window (--force-window):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CmbForceWindow" VerticalAlignment="Center">
                                            <ComboBoxItem Content="immediate (Fastest / Hemen Aç)" Tag="immediate" IsSelected="True"/>
                                            <ComboBoxItem Content="yes (On Media Loaded)" Tag="yes"/>
                                            <ComboBoxItem Content="no (Disabled)" Tag="no"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock x:Name="TxtMpvGeometryLabel" Text="Window Geometry (--geometry):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtMpvGeometry" Background="{DynamicResource InputBrush}" Foreground="White" FontSize="12" Padding="10,4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Text="960x540"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock x:Name="TxtMpvProfileLabel" Text="MPV Profile (--profile):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtMpvProfile" Background="{DynamicResource InputBrush}" Foreground="White" FontSize="12" Padding="10,4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TxtMpvExtraArgsLabel" Text="Extra MPV Parameters (e.g. --hwdec=auto):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtMpvExtraArgs" Background="{DynamicResource InputBrush}" Foreground="White" FontSize="12" Padding="10,4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,16"/>

                                <Button x:Name="BtnSaveMpvSettings" Style="{StaticResource ModernButton}" Content="Save Settings" Click="BtnSaveMpvSettings_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardTorrentSettings" Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock x:Name="TxtTorrentSettingsTitle" Text="Torrent streaming (optional)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtTorrentSettingsDesc" Text="Off by default. When enabled, torrent links, .torrent files and info hashes are streamed through a local helper." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <CheckBox x:Name="ChkTorrentEnabled" Content="Enable torrent streaming" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,8" Checked="ChkTorrentEnabled_Changed" Unchecked="ChkTorrentEnabled_Changed"/>
                                <TextBlock x:Name="TxtTorrentPrivacy" Text="Your IP address is visible to peers and trackers while a torrent is open. Only use content you own or that is legal to share. Nothing is seeded after you stop." FontSize="11" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock x:Name="TxtTorrentDownloadDirLabel" Text="Temporary download folder:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>

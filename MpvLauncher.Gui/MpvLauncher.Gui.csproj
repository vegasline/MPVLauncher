<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyName>MPVLauncher</AssemblyName>
    <RootNamespace>MpvLauncher.Gui</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Custom Program.Main: host mode without GUI -->
    <StartupObject>MpvLauncher.Gui.Program</StartupObject>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- App version. Deliberately separate from extension/manifest.json: the
         extension ships through addons.mozilla.org on its own schedule, and
         the two must not be bumped together. Keep this in step with the git tag. -->
    <Version>1.9.15</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\themes\*.json">
      <LogicalName>embedded.themes.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Artwork a theme paints behind its cards. Kept out of the themes folder
         itself so the JSON glob above stays a list of theme files. -->
    <EmbeddedResource Include="..\themes\backgrounds\*.*">
      <LogicalName>embedded.backgrounds.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\locales\*.json">
      <LogicalName>embedded.languages.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\extension\*.*">
      <LogicalName>embedded.extension.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="anime4k\**\*.*">
      <LogicalName>embedded.anime4k.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Remove="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The manifest builders are internal so a test can write one and read it
         back. Three files used to keep three copies of the extension manifest
         and none of them parsed any of them, so they drifted apart silently. -->
    <InternalsVisibleTo Include="MpvLauncher.Gui.Tests" />
  </ItemGroup>

</Project>

<Window x:Class="MpvLauncher.Gui.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renk ve Saydamlık Seçici"
        Width="380"
        Height="490"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="#1A1E27" CornerRadius="12" BorderBrush="#3B455B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="🎨 Renk &amp; Saydamlık Paleti" FontSize="15" FontWeight="SemiBold" Foreground="#F0F2F5" VerticalAlignment="Center"/>
                <Button Content="✕" Click="BtnCancel_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#9AA3B2" BorderThickness="0" FontSize="14" Cursor="Hand" Width="24" Height="24"/>
            </DockPanel>

            <!-- Preview & Hex Input -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ColorPreviewBorder" Grid.Column="0" Height="50" CornerRadius="8" BorderBrush="#4B5563" BorderThickness="1" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Seçilen Renk / Hex Kodu:" FontSize="11" Foreground="#9AA3B2" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtHexResult" Background="#33000000" Foreground="White" FontSize="13" FontWeight="SemiBold" Padding="8,6" BorderBrush="#33FFFFFF" BorderThickness="1" TextChanged="TxtHexResult_TextChanged"/>
                </StackPanel>
            </Grid>

            <!-- Sliders: R, G, B, A -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <!-- Red -->
                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Kırmızı (Red):" FontSize="11" Foreground="#9AA3B2"/>
                    <TextBlock x:Name="TxtValR" Text="255" FontSize="11" Foreground="#F43F5E" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SliderR" Minimum="0" Maximum="255" Value="99" Margin="0,0,0,8" ValueChanged="Slider_ValueChanged"/>

                <!-- Green -->
                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Yeşil (Green):" FontSize="11" Foreground="#9AA3B2"/>
                    <TextBlock x:Name="TxtValG" Text="255" FontSize="11" Foreground="#10B981" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SliderG" Minimum="0" Maximum="255" Value="102" Margin="0,0,0,8" ValueChanged="Slider_ValueChanged"/>

                <!-- Blue -->
                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Mavi (Blue):" FontSize="11" Foreground="#9AA3B2"/>
                    <TextBlock x:Name="TxtValB" Text="255" FontSize="11" Foreground="#3B82F6" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SliderB" Minimum="0" Maximum="255" Value="241" Margin="0,0,0,8" ValueChanged="Slider_ValueChanged"/>

                <!-- Alpha / Saydamlık -->
                <DockPanel Margin="0,0,0,2">
                    <TextBlock Text="Saydamlık (Alpha):" FontSize="11" Foreground="#9AA3B2"/>
                    <TextBlock x:Name="TxtValA" Text="100%" FontSize="11" Foreground="#A855F7" HorizontalAlignment="Right"/>
                </DockPanel>
                <Slider x:Name="SliderA" Minimum="0" Maximum="255" Value="255" Margin="0,0,0,8" ValueChanged="Slider_ValueChanged"/>
            </StackPanel>

            <!-- Quick Swatches -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Text="Hızlı Renk Paleti:" FontSize="11" Foreground="#9AA3B2" Margin="0,0,0,6"/>
                <WrapPanel x:Name="PanelSwatches"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Click="BtnCancel_Click" Background="#2A303C" Foreground="#F0F2F5" BorderBrush="#3B455B" BorderThickness="1" Padding="14,8" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Uygula &amp; Seç" Click="BtnOk_Click" Background="#6366F1" Foreground="White" BorderThickness="0" Padding="16,8" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
